datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

// Identity itself lives in Supabase's own `auth.users` table (managed by
// Supabase Auth, not Prisma). `Profile.id` is always set to that same UUID —
// a 1:1 extension, not a second identity table — so there's one source of
// truth for "who this person is" and Prisma only ever owns the columns
// below. A raw FK (`profiles.id -> auth.users.id`) is added via SQL
// migration once the database exists; Prisma intentionally never declares a
// model for `auth.users` itself so `prisma migrate` can never touch it.

enum AccountStatus {
  PENDING
  ACTIVE
  PENDING_CLOSURE
  CLOSED
}

enum ProfileRole {
  CUSTOMER
  ADMIN
}

model Profile {
  id String @id @db.Uuid // == auth.users.id (Supabase Auth)

  firstName String
  lastName  String
  dob       DateTime
  mobile    String
  email     String  @unique // mirrors auth.users.email, for querying/joins
  username  String  @unique
  avatarUrl String?

  addressLine1   String?
  addressLine2   String?
  city           String?
  postcode       String?
  country        String?
  customerNumber String  @unique

  status AccountStatus @default(PENDING)
  role   ProfileRole   @default(CUSTOMER)

  lastLoginAt DateTime?

  // Forced on by a "No, secure my account" security response — blocks login
  // until the password is reset via Supabase's recovery-OTP flow.
  mustResetPassword Boolean @default(false)

  // Account-closure flow — our own PIN-over-email confirmation, independent
  // of Supabase Auth (which has no such feature).
  deletionPinHash        String?
  deletionPinExpiresAt   DateTime?
  deletionAttempts       Int       @default(0)
  deletionPinLastSentAt  DateTime?
  deletionVerifiedAt     DateTime?
  closureRequestedAt     DateTime?
  closedAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  devices        Device[]
  loginSessions  LoginSession[]
  securityEvents SecurityEvent[]
  notifications  Notification[]
  transactions   Transaction[]

  @@map("profiles")
}

enum DeviceType {
  MOBILE_PHONE
  TABLET
  DESKTOP
  UNKNOWN
}

model Device {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String  @db.Uuid

  // Opaque, long-lived identifier from the `piggy_device` cookie (or native
  // Capacitor device id) — the actual recognition key, independent of UA.
  deviceId String

  label      String
  deviceType DeviceType @default(UNKNOWN)
  os         String? // free text: "iOS 17", "Android 14", "Windows 11", "macOS 15", ...
  browser    String?
  // Only ever populated when reliably present in the UA/native info —
  // never a guessed/invented model.
  model      String?

  trusted Boolean @default(false)

  lastIp       String?
  lastCity     String?
  lastCountry  String?
  lastActiveAt DateTime @default(now())

  confirmedAt DateTime?
  blockedAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([profileId, deviceId])
  @@index([profileId])
  @@map("devices")
}

model LoginSession {
  // Supabase Auth owns the actual session/auth token; this table only
  // tracks per-login device/audit metadata (renamed from the old `Session`
  // model, which played the same role for the custom-JWT auth it replaces).
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String  @db.Uuid

  deviceRowId String?

  userAgent String?
  ip        String?

  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  logoutAt     DateTime?
  logoutReason String?
  revokedAt    DateTime?

  @@index([profileId])
  @@map("login_sessions")
}

enum LoginStatus {
  SUCCESS
  FAILED
  BLOCKED
}

model SecurityEvent {
  // Unified audit trail — absorbs the old `LoginEvent` (structured login
  // tracking) and `AccountAuditLog` (free-form event log) into one table.
  // `type` stays a free-form string (e.g. 'login_success', 'device_trusted',
  // 'closure_requested', 'sensitive_details_viewed') rather than a fixed
  // enum, matching every existing call site with zero renames required.
  id String @id @default(cuid())

  profile   Profile? @relation(fields: [profileId], references: [id])
  profileId String?  @db.Uuid

  type   String
  status LoginStatus? // populated only for login attempts

  deviceRowId String?
  sessionId   String?
  isNewDevice Boolean?

  ip         String?
  city       String?
  country    String?
  userAgent  String?
  os         String?
  browser    String?
  deviceType DeviceType?

  confirmedAt     DateTime?
  confirmedAsSelf Boolean?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([profileId])
  @@index([ip])
  @@map("security_events")
}

enum AccountType {
  PARENT
  KID
}

model Account {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String  @db.Uuid

  // A kid account belongs to a parent's own account, not directly to a
  // second profile — kids don't hold their own Supabase Auth identity.
  parentAccount   Account?  @relation("KidOfParent", fields: [parentAccountId], references: [id])
  parentAccountId String?
  kidAccounts     Account[] @relation("KidOfParent")

  type          AccountType
  name          String
  accountNumber String        @unique
  sortCode      String
  balance       Decimal       @default(0) @db.Decimal(12, 2)
  savingsTarget Decimal?      @db.Decimal(12, 2)
  status        AccountStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards           Card[]
  transactionsOut Transaction[] @relation("FromAccount")
  transactionsIn  Transaction[] @relation("ToAccount")

  @@index([profileId])
  @@map("accounts")
}

enum CardBrand {
  VISA
  MASTERCARD
}

enum CardStatus {
  ACTIVE
  FROZEN
  LOCKED
  CANCELLED
}

model Card {
  id        String  @id @default(cuid())
  account   Account @relation(fields: [accountId], references: [id])
  accountId String

  cardholderName String
  // Tokenised reference from the card provider — never a raw PAN.
  providerCardId String    @unique
  last4          String
  brand          CardBrand
  expMonth       Int
  expYear        Int
  status         CardStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@map("cards")
  // No CVV column, ever — see AGENTS.md card-details security rules.
}

enum TransactionType {
  PAYMENT
  TRANSFER
  DEPOSIT
  SPEND
  SAVINGS
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

model Transaction {
  id String @id @default(cuid())
  // Public-facing reference, e.g. PB-20260831-8F3K2A. Never expose `id` above to clients.
  transactionNumber String @unique

  // Owning profile — the family account this transaction belongs to.
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String  @db.Uuid

  type   TransactionType
  status TransactionStatus @default(COMPLETED)

  amount Float

  // Display labels always shown; the FKs below are populated once the
  // counterparty is a real Account row (kids/cards are being migrated off
  // the mock store — see Phase 1 plan).
  fromLabel String
  toLabel   String

  fromAccount   Account? @relation("FromAccount", fields: [fromAccountId], references: [id])
  fromAccountId String?
  toAccount     Account? @relation("ToAccount", fields: [toAccountId], references: [id])
  toAccountId   String?

  reference String?
  category  String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([profileId])
  @@map("transactions")
}

enum NotificationType {
  PAYMENT_RECEIVED
  TRANSFER_COMPLETED
  TRANSFER_FAILED
  NEW_LOGIN
  SUSPICIOUS_LOGIN
  CARD_FROZEN
  CARD_UNLOCKED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  NEW_KID_ACCOUNT
  ACCOUNT_APPROVED
  PIN_VERIFICATION
  SAVINGS_TARGET_REACHED
  ACCOUNT_CLOSURE_REQUESTED
  ACCOUNT_CLOSURE_CANCELLED
  ACCOUNT_CLOSED
  CARD_DETAILS_VIEWED
}

model Notification {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String  @db.Uuid

  type        NotificationType
  title       String
  message     String
  read        Boolean @default(false)
  actionLabel String?
  actionHref  String?

  createdAt DateTime @default(now())

  @@index([profileId])
  @@map("notifications")
}
