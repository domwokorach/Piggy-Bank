datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

enum AccountStatus {
  ACTIVE
  PENDING_CLOSURE
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  dob          DateTime
  mobile       String
  email        String   @unique
  username     String   @unique
  avatarUrl    String?
  passwordHash String

  emailVerified Boolean       @default(false)
  status        AccountStatus @default(ACTIVE)

  lastLoginAt DateTime?

  // Forced on by a "No, secure my account" security response — blocks login
  // until the password is reset via the PIN-based reset flow below.
  mustResetPassword Boolean @default(false)

  verificationPinHash      String?
  verificationPinExpiresAt DateTime?
  verificationAttempts     Int       @default(0)

  deletionPinHash        String?
  deletionPinExpiresAt   DateTime?
  deletionAttempts       Int       @default(0)
  deletionPinLastSentAt  DateTime?
  deletionVerifiedAt     DateTime?
  closureRequestedAt     DateTime?
  closedAt               DateTime?

  resetPinHash        String?
  resetPinExpiresAt   DateTime?
  resetAttempts       Int       @default(0)
  resetPinLastSentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum DeviceType {
  MOBILE_PHONE
  TABLET
  DESKTOP
  UNKNOWN
}

enum LoginStatus {
  SUCCESS
  FAILED
  BLOCKED
}

model Device {
  id     String @id @default(cuid())
  userId String

  // Opaque, long-lived identifier from the `piggy_device` cookie (or native
  // Capacitor device id) — the actual recognition key, independent of UA.
  deviceId String

  label      String
  deviceType DeviceType @default(UNKNOWN)
  os         String?
  browser    String?
  // Only ever populated when reliably present in the UA/native info —
  // never a guessed/invented model.
  model      String?

  trusted Boolean @default(false)

  lastIp       String?
  lastCity     String?
  lastCountry  String?
  lastActiveAt DateTime @default(now())

  confirmedAt DateTime?
  blockedAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("devices")
}

model Session {
  id       String  @id @default(cuid())
  userId   String
  deviceRowId String?

  userAgent String?
  ip        String?

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@map("sessions")
}

model LoginEvent {
  id     String @id @default(cuid())
  // Nullable so failed attempts against an unknown identifier can still be
  // logged (and rate-limited on) without a matching user.
  userId String?

  deviceRowId String?
  sessionId   String?

  status      LoginStatus
  isNewDevice Boolean     @default(false)

  ip         String?
  city       String?
  country    String?
  userAgent  String?
  os         String?
  browser    String?
  deviceType DeviceType?

  confirmedAt     DateTime?
  confirmedAsSelf Boolean?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([ip])
  @@map("login_events")
}

model AccountAuditLog {
  id        String   @id @default(cuid())
  userId    String
  event     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("account_audit_logs")
}

enum TransactionType {
  PAYMENT
  TRANSFER
  DEPOSIT
  SPEND
  SAVINGS
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

model Transaction {
  id                String            @id @default(cuid())
  // Public-facing reference, e.g. PB-20260831-8F3K2A. Never expose `id` above to clients.
  transactionNumber String            @unique

  // Owning parent User — the family account this transaction belongs to.
  userId String

  type   TransactionType
  status TransactionStatus @default(COMPLETED)

  amount Float

  // Kids/cards aren't backed by Postgres yet, so the counterparties are
  // stored as display labels + loose (non-FK) ids rather than relations.
  fromLabel     String
  toLabel       String
  fromAccountId String?
  toAccountId   String?

  reference String?
  category  String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@map("transactions")
}
