datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

enum AccountStatus {
  ACTIVE
  PENDING_CLOSURE
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  dob          DateTime
  mobile       String
  email        String   @unique
  username     String   @unique
  avatarUrl    String?
  passwordHash String

  emailVerified Boolean       @default(false)
  status        AccountStatus @default(ACTIVE)

  // Bumped whenever all active sessions must be revoked (e.g. account closure).
  // A session's JWT carries the version it was issued under; a mismatch invalidates it.
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?

  verificationPinHash      String?
  verificationPinExpiresAt DateTime?
  verificationAttempts     Int       @default(0)

  deletionPinHash        String?
  deletionPinExpiresAt   DateTime?
  deletionAttempts       Int       @default(0)
  deletionPinLastSentAt  DateTime?
  deletionVerifiedAt     DateTime?
  closureRequestedAt     DateTime?
  closedAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model AccountAuditLog {
  id        String   @id @default(cuid())
  userId    String
  event     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("account_audit_logs")
}

enum TransactionType {
  PAYMENT
  TRANSFER
  DEPOSIT
  SPEND
  SAVINGS
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

model Transaction {
  id                String            @id @default(cuid())
  // Public-facing reference, e.g. PB-20260831-8F3K2A. Never expose `id` above to clients.
  transactionNumber String            @unique

  // Owning parent User — the family account this transaction belongs to.
  userId String

  type   TransactionType
  status TransactionStatus @default(COMPLETED)

  amount Float

  // Kids/cards aren't backed by Postgres yet, so the counterparties are
  // stored as display labels + loose (non-FK) ids rather than relations.
  fromLabel     String
  toLabel       String
  fromAccountId String?
  toAccountId   String?

  reference String?
  category  String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@map("transactions")
}
