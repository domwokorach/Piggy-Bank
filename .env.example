# App
NEXT_PUBLIC_APP_NAME="Piggy Bank"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/piggy_bank"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/piggy_bank"

# Authentication
AUTH_SECRET="replace-with-secure-random-secret"
AUTH_URL="http://localhost:3000"

# API
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
API_SECRET="replace-with-api-secret"

# Email / PIN Verification
EMAIL_FROM="noreply@example.com"
EMAIL_PROVIDER_API_KEY="replace-with-email-api-key"

# SMS / OTP
SMS_ACCOUNT_ID="replace-with-sms-account-id"
SMS_AUTH_TOKEN="replace-with-sms-auth-token"
SMS_FROM_NUMBER="+440000000000"

# Real-Time
REALTIME_URL="replace-with-realtime-url"
REALTIME_API_KEY="replace-with-realtime-api-key"

# File / Avatar Uploads
STORAGE_URL="replace-with-storage-url"
STORAGE_BUCKET="avatars"
STORAGE_ACCESS_KEY="replace-with-access-key"
STORAGE_SECRET_KEY="replace-with-secret-key"

# Security
ENCRYPTION_KEY="replace-with-encryption-key"
SESSION_SECRET="replace-with-session-secret"

# Optional Analytics
NEXT_PUBLIC_ANALYTICS_ID="replace-with-analytics-id"
